# Copy to .env.local. Never commit actual values.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only PostgreSQL connection with TLS and SET ROLE service_role permission.
DATABASE_URL=
# Optional server-only override; the public Supabase Root 2021 CA is bundled.
# Download a replacement from Supabase Database Settings > SSL Configuration.
# Paste the full PEM; a single line with literal \n between its lines also works.
DATABASE_SSL_CA=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_CONTACT_URL=
# Ignored in production. npm run dev:local enables this explicitly.
PIXVO_LOCAL_DEV=0
PIXVO_DATA_DIR=.data
PAYMENTS_ENABLED=false
MERCADOPAGO_ENV=sandbox
# Checkout Pro Orders: select Prueba in Developers. Test tokens can start APP_USR.
MERCADOPAGO_ACCESS_TOKEN=
# Webhooks: same environment, Order (Mercado Pago), /api/webhooks/mercadopago.
MERCADOPAGO_WEBHOOK_SECRET=
# Seller user ID for that environment; not the application/client ID.
MERCADOPAGO_COLLECTOR_ID=
# Only behind a proxy that overwrites x-forwarded-for and blocks direct access.
TRUST_PROXY=false
