{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "templateId": {
      "type": "string"
    },
    "templateVersion": {
      "type": "number",
      "const": 1
    },
    "event": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": [
            "xv",
            "weddings",
            "parties",
            "kids",
            "corporate"
          ]
        },
        "startsAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "endsAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "type": "string",
          "maxLength": 80
        },
        "hosts": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "description": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "title",
        "category",
        "startsAt",
        "timezone",
        "hosts",
        "message"
      ],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "headingFont": {
          "type": "string",
          "enum": [
            "Urbanist",
            "Inter Tight",
            "Playfair Display",
            "DM Serif Display",
            "Cinzel",
            "Cormorant Garamond",
            "Montserrat",
            "Poppins",
            "Bebas Neue",
            "Nunito",
            "Fredoka",
            "Bungee",
            "Orbitron",
            "Sora",
            "Space Grotesk",
            "Dancing Script",
            "Great Vibes",
            "Pacifico",
            "Quicksand",
            "Outfit",
            "Roboto",
            "Lora",
            "Georgia",
            "Arial"
          ]
        },
        "bodyFont": {
          "type": "string",
          "enum": [
            "Urbanist",
            "Inter Tight",
            "Playfair Display",
            "DM Serif Display",
            "Cinzel",
            "Cormorant Garamond",
            "Montserrat",
            "Poppins",
            "Bebas Neue",
            "Nunito",
            "Fredoka",
            "Bungee",
            "Orbitron",
            "Sora",
            "Space Grotesk",
            "Dancing Script",
            "Great Vibes",
            "Pacifico",
            "Quicksand",
            "Outfit",
            "Roboto",
            "Lora",
            "Georgia",
            "Arial"
          ]
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 80
        },
        "family": {
          "type": "string",
          "enum": [
            "editorial",
            "ornamental",
            "party",
            "kids",
            "corporate"
          ]
        },
        "backgroundAsset": {
          "type": "string"
        },
        "backgroundMediaId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "videoId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "videoAutoplay": {
          "default": false,
          "type": "boolean"
        },
        "videoLoop": {
          "default": false,
          "type": "boolean"
        },
        "posterId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "overlay": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "focusX": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "focusY": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "scale": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.5
        },
        "buttonScale": {
          "default": 1,
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.25
        },
        "spacing": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "sampleStyle": {
          "type": "string",
          "enum": [
            "romantic",
            "neon",
            "royal",
            "butterfly",
            "envelope"
          ]
        }
      },
      "required": [
        "accent",
        "background",
        "foreground",
        "headingFont",
        "bodyFont",
        "radius",
        "family",
        "backgroundAsset",
        "videoAutoplay",
        "videoLoop",
        "overlay",
        "focusX",
        "focusY",
        "align",
        "scale",
        "buttonScale",
        "spacing"
      ],
      "additionalProperties": false
    },
    "blocks": {
      "minItems": 2,
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "type": "string",
            "enum": [
              "hero",
              "countdown",
              "venues",
              "message",
              "rsvp",
              "calendar",
              "gallery",
              "dressCode",
              "gifts",
              "music",
              "social",
              "songRequests",
              "agenda"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "props": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 120
              },
              "text": {
                "type": "string",
                "maxLength": 2000
              },
              "eyebrow": {
                "type": "string",
                "maxLength": 80
              },
              "items": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 120
                    },
                    "address": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "time": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "url": {
                      "type": "string",
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              },
              "photos": {
                "maxItems": 60,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "mediaId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "alt": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "caption": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "focusX": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "focusY": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "mediaId",
                    "alt"
                  ],
                  "additionalProperties": false
                }
              },
              "maxAttendees": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "capacity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "mode": {
                "type": "string",
                "enum": [
                  "open",
                  "guest"
                ]
              },
              "closesAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "askDiet": {
                "type": "boolean"
              },
              "whatsapp": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\+?[0-9]{8,15}$"
                  },
                  {
                    "type": "string",
                    "const": ""
                  }
                ]
              },
              "alias": {
                "type": "string",
                "maxLength": 100
              },
              "holder": {
                "type": "string",
                "maxLength": 100
              },
              "url": {
                "type": "string",
                "maxLength": 1000
              },
              "hashtag": {
                "type": "string",
                "maxLength": 100
              },
              "audioId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "spotify": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type",
          "enabled",
          "props"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "templateId",
    "templateVersion",
    "event",
    "theme",
    "blocks"
  ],
  "additionalProperties": false,
  "$id": "urn:pixvo:invitation:1",
  "title": "Pixvo Invitation Document"
}
